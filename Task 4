
<!DOCTYPE html>
<html>
<head>
    <title>Space Website</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: black;
            color: white;
            text-align: center;
        }

        nav {
            background-color: navy;
            padding: 15px;
        }

        nav a {
            color: white;
            margin: 10px;
            text-decoration: none;
        }

        nav a:hover {
            color: yellow;
        }

        h1 {
            color: skyblue;
        }

        .rocket {
            font-size: 80px;
            animation: fly 2s infinite;
        }

        @keyframes fly {
            0% {
                margin-top: 20px;
            }

            50% {
                margin-top: 0px;
            }

            100% {
                margin-top: 20px;
            }
        }

        button {
            background-color: skyblue;
            padding: 10px;
            border: none;
        }

        button:hover {
            background-color: yellow;
        }

        .box {
            background-color: navy;
            padding: 20px;
            margin-bottom: 10px;
        }

.rocket {
    font-size: 80px;
    animation: fly 2s infinite;
}

@keyframes fly {
    0% {
        transform: translateY(0px);
    }

    50% {
        transform: translateY(-50px);
    }

    100% {
        transform: translateY(0px);
    }
}

    </style>
</head>

<body>

    <!-- Navbar -->
    <nav>
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#explore">Explore</a>
    </nav>

    <!-- Home -->
    <div class="container p-5" id="home">

        <h1>Explore Space</h1>

        <p>Welcome to the world of planets and stars!</p>

        <div class="rocket">🚀</div>

        <button onclick="location.href='#explore'">
            Explore Now
        </button>

    </div>

    <!-- About -->
    <div class="container p-4" id="about">

        <h1>About Space</h1>

        <p>Space is full of planets, stars and galaxies.</p>

    </div>

    <!-- Explore -->
    <div class="container p-4" id="explore">

        <h1>Explore More</h1>

        <div class="row">

            <div class="col-md-4">
                <div class="box">
                    <h3>Planets 🌍</h3>
                    <p>Learn about planets.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="box">
                    <h3>Galaxies 🌌</h3>
                    <p>Learn about galaxies.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="box">
                    <h3>Astronauts 👨‍🚀</h3>
                    <p>Learn about astronauts.</p>
                </div>
            </div>

        </div>
    </div>

    <!-- Footer -->
    <footer>
        <p>My Space Website - 2026</p>
    </footer>

</body>
</html>
